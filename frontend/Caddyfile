# SITE_ADDRESS=":80" sirve HTTP plano (local).
# SITE_ADDRESS="littlestyle.duckdns.org" activa HTTPS con Let's Encrypt (producción).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API y webhook de Wompi
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Imágenes con almacenamiento local (en producción se sirven desde S3)
	handle /media/* {
		reverse_proxy backend:8080
	}

	# Jenkins (deploy/jenkins), incluido el webhook de GitHub en /jenkins/github-webhook/
	handle /jenkins* {
		reverse_proxy jenkins:8080
	}

	# SPA de Angular: cualquier ruta desconocida cae en index.html
	handle {
		root * /srv

		# Los .js y .css llevan hash en el nombre: nunca cambian. index.html se revalida siempre,
		# si no el navegador sigue usando el de un despliegue anterior y pide chunks que ya no existen.
		@hasheados path *.js *.css
		header @hasheados Cache-Control "public, max-age=31536000, immutable"
		@paginas not path *.js *.css
		header @paginas Cache-Control "no-cache"

		# Un chunk que no existe responde 404, no index.html (que el navegador rechaza como módulo)
		@spa {
			not path *.js *.css
			not file
		}
		rewrite @spa /index.html
		file_server
	}
}
