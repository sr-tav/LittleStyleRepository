# Copiar a .env (no se versiona). Variables de Jenkins, separadas de las de la app.

JENKINS_ADMIN_ID=admin
# Generar con: openssl rand -base64 18
JENKINS_ADMIN_PASSWORD=
# Local: http://localhost/jenkins/   |   Producción: https://littlestyle.duckdns.org/jenkins/
JENKINS_URL=https://littlestyle.duckdns.org/jenkins/

# gid del grupo docker del host: getent group docker | cut -d: -f3   (Docker Desktop: 0)
DOCKER_GID=

GITHUB_REPO_URL=https://github.com/sr-tav/LittleStyleRepository.git
GITHUB_BRANCH=main
# Solo si el repositorio es privado
GITHUB_USER=
GITHUB_TOKEN=
