<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="demanda" language="java" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <style name="base" default="true" fontName="DejaVu Sans" fontSize="8.5"/>
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="SUBTITULO" class="java.lang.String"/>
    <parameter name="ALCANCE" class="java.lang.String"/>
    <parameter name="GENERADO_EN" class="java.lang.String"/>
    <parameter name="GENERADO_POR" class="java.lang.String"/>
    <parameter name="TOTAL_REGISTROS" class="java.lang.String"/>
    <field name="seccion" class="java.lang.String"/>
    <field name="etiqueta" class="java.lang.String"/>
    <field name="talla" class="java.lang.String"/>
    <field name="unidades" class="java.lang.String"/>
    <field name="valorMoneda" class="java.lang.String"/>
    <field name="unidadesNum" class="java.lang.Long"/>
    <field name="valorNum" class="java.math.BigDecimal"/>
    <variable name="unidadesSeccion" class="java.lang.Long" calculation="Sum" resetType="Group" resetGroup="Seccion">
        <expression><![CDATA[$F{unidadesNum}]]></expression>
    </variable>
    <variable name="valorSeccion" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="Seccion">
        <expression><![CDATA[$F{valorNum}]]></expression>
    </variable>
    <group name="Seccion" reprintHeaderOnEachPage="true">
        <expression><![CDATA[$F{seccion}]]></expression>
        <groupHeader>
            <band height="24">
                <element kind="textField" x="0" y="2" width="555" height="18" fontSize="9.5" bold="true" forecolor="#14532D" vTextAlign="Middle">
                    <expression><![CDATA[$F{seccion}]]></expression>
                </element>
                <element kind="line" x="0" y="22" width="555" height="1">
                    <pen lineWidth="0.8" lineColor="#15803D"/>
                </element>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="24">
                <element kind="line" x="0" y="0" width="555" height="1">
                    <pen lineWidth="0.8" lineColor="#15803D"/>
                </element>
                <element kind="textField" x="0" y="3" width="260" height="16" fontSize="8.5" bold="true" forecolor="#14532D">
                    <expression><![CDATA["Subtotal " + $F{seccion}]]></expression>
                </element>
                <element kind="textField" x="330" y="3" width="80" height="16" fontSize="8.5" bold="true" hTextAlign="Right" pattern="#,##0">
                    <expression><![CDATA[$V{unidadesSeccion}]]></expression>
                </element>
                <element kind="textField" x="410" y="3" width="145" height="16" fontSize="8.5" bold="true" hTextAlign="Right" pattern="'COP' #,##0">
                    <expression><![CDATA[$V{valorSeccion}]]></expression>
                </element>
            </band>
        </groupFooter>
    </group>
    <title height="84">
        <element kind="textField" x="0" y="0" width="180" height="32" fontSize="14.0" bold="true" forecolor="#FFFFFF" backcolor="#14532D" mode="Opaque" vTextAlign="Middle">
            <expression><![CDATA["  LittleStyle"]]></expression>
        </element>
        <element kind="textField" x="180" y="0" width="375" height="32" fontSize="11.0" bold="true" forecolor="#FFFFFF" backcolor="#15803D" mode="Opaque" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA[$P{TITULO} + "  "]]></expression>
        </element>
        <element kind="textField" x="0" y="38" width="555" height="14" fontSize="9.0" forecolor="#374151">
            <expression><![CDATA[$P{SUBTITULO}]]></expression>
        </element>
        <element kind="textField" x="0" y="54" width="555" height="12" fontSize="8.0" forecolor="#6B7280">
            <expression><![CDATA["Alcance: " + $P{ALCANCE} + "   ·   Generado: " + $P{GENERADO_EN} + "   ·   Por: " + $P{GENERADO_POR}]]></expression>
        </element>
        <element kind="line" x="0" y="72" width="555" height="1">
            <pen lineWidth="1.0" lineColor="#14532D"/>
        </element>
    </title>
    <columnHeader height="24">
        <element kind="staticText" x="0" y="0" width="260" height="24" fontSize="8.5" bold="true" forecolor="#FFFFFF" backcolor="#14532D" mode="Opaque" vTextAlign="Middle">
            <text><![CDATA[  Prenda]]></text>
        </element>
        <element kind="staticText" x="260" y="0" width="70" height="24" fontSize="8.5" bold="true" forecolor="#FFFFFF" backcolor="#14532D" mode="Opaque" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[Talla]]></text>
        </element>
        <element kind="staticText" x="330" y="0" width="80" height="24" fontSize="8.5" bold="true" forecolor="#FFFFFF" backcolor="#14532D" mode="Opaque" hTextAlign="Right" vTextAlign="Middle">
            <text><![CDATA[Unidades  ]]></text>
        </element>
        <element kind="staticText" x="410" y="0" width="145" height="24" fontSize="8.5" bold="true" forecolor="#FFFFFF" backcolor="#14532D" mode="Opaque" hTextAlign="Right" vTextAlign="Middle">
            <text><![CDATA[Valor  ]]></text>
        </element>
    </columnHeader>
    <detail>
        <band height="17">
            <element kind="textField" x="0" y="0" width="260" height="17" fontSize="8.5" textAdjust="StretchHeight" vTextAlign="Middle">
                <expression><![CDATA["  " + $F{etiqueta}]]></expression>
            </element>
            <element kind="textField" x="260" y="0" width="70" height="17" fontSize="8.5" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{talla}]]></expression>
            </element>
            <element kind="textField" x="330" y="0" width="80" height="17" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{unidades} + "  "]]></expression>
            </element>
            <element kind="textField" x="410" y="0" width="145" height="17" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle">
                <expression><![CDATA[$F{valorMoneda} + "  "]]></expression>
            </element>
            <element kind="line" x="0" y="16" width="555" height="1">
                <pen lineWidth="0.3" lineColor="#E7E5E4"/>
            </element>
        </band>
    </detail>
    <summary height="52">
        <element kind="line" x="0" y="2" width="555" height="1">
            <pen lineWidth="1.0" lineColor="#14532D"/>
        </element>
        <element kind="textField" x="0" y="8" width="555" height="14" fontSize="8.5" bold="true" forecolor="#14532D">
            <expression><![CDATA["Filas incluidas en el reporte: " + $P{TOTAL_REGISTROS}]]></expression>
        </element>
        <element kind="staticText" x="0" y="26" width="555" height="12" fontSize="7.5" forecolor="#6B7280">
            <text><![CDATA[Documento generado automáticamente por LittleStyle · Información confidencial para uso interno]]></text>
        </element>
    </summary>
    <pageFooter height="24">
        <element kind="staticText" x="0" y="6" width="300" height="12" fontSize="7.5" forecolor="#6B7280">
            <text><![CDATA[LittleStyle · Reporte corporativo]]></text>
        </element>
        <element kind="textField" x="450" y="6" width="80" height="12" fontSize="7.5" forecolor="#6B7280" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="530" y="6" width="25" height="12" fontSize="7.5" forecolor="#6B7280" evaluationTime="Report">
            <expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>
</jasperReport>
