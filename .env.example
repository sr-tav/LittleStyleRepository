# Copiar a .env (no se versiona) y completar. Nunca subir valores reales al repositorio.

# --- Web ---
# Local: :80   |   Producción: littlestyle.duckdns.org (HTTPS automático)
SITE_ADDRESS=:80
# Local: http://localhost   |   Producción: https://littlestyle.duckdns.org
CORS_ALLOWED_ORIGINS=http://localhost

# --- Base de datos ---
# Local: lo sobrescribe docker-compose.local.yml   |   Producción: endpoint de RDS
DB_HOST=
DB_USER=littlestyle
DB_PASSWORD=
# Solo para el MySQL local
DB_ROOT_PASSWORD=

# --- Secretos (Base64). Generar con: openssl rand -base64 64 / openssl rand -base64 32 ---
JWT_SECRET=
# 32 bytes. En producción debe ser LA MISMA clave con la que se cifraron los perfiles existentes.
PERFIL_ENC_KEY=

# --- Administrador inicial (opcional; solo se crea si no existe) ---
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Almacenamiento S3 (producción; en EC2 las credenciales vienen del rol IAM) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_URL_PUBLICA=
# Solo si se prueba S3 desde un PC local, sin rol IAM:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Correo Gmail SMTP (contraseña de aplicación) ---
MAIL_USER=
MAIL_PASS=

# --- Wompi ---
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Solo con dominio público: https://littlestyle.duckdns.org/cliente/pago/resultado
WOMPI_REDIRECT_URL=
